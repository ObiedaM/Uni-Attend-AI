{
  "manifest_version": 3,
  "name": "UniAttend AI — Smart Voice Attendance",
  "version": "2.0.0",
  "description": "Fast, private bilingual (AR/EN) voice attendance with native TTS, hardware mic-mute guard, and universal portal support. By Obieda.M",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_title": "Open / Close UniAttend AI (Alt+A)"
  },
  "commands": {
    "toggle-hud": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Toggle UniAttend AI on the current tab"
    }
  }
}